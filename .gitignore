########################################
# Terraform
########################################

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Terraform lock file (optional but often ignored in infra repos)
.terraform.lock.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json


########################################
# Sensitive files
########################################

# Environment variables
.env
.env.*

# AWS credentials
.aws/


########################################
# Kubernetes
########################################

# Local kubeconfig files
kubeconfig
*.kubeconfig


########################################
# Node / JavaScript (future app components)
########################################

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*


########################################
# Docker
########################################

docker-compose.override.yml


########################################
# Logs
########################################

*.log


########################################
# IDE / Editor
########################################

# VSCode
.vscode/

# JetBrains
.idea/

# Vim
*.swp
*.swo


########################################
